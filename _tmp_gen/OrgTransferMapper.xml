<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhehang.erp.modules.org.mapper.OrgTransferMapper">

    <resultMap id="TransferVOMap" type="com.zhehang.erp.modules.org.domain.vo.TransferVO">
        <id column="id" property="id"/>
        <result column="employee_id" property="employeeId"/>
        <result column="employee_name" property="employeeName"/>
        <result column="emp_code" property="empCode"/>
        <result column="transfer_type" property="transferType"/>
        <result column="from_dept_id" property="fromDeptId"/>
        <result column="from_dept_name" property="fromDeptName"/>
        <result column="to_dept_id" property="toDeptId"/>
        <result column="to_dept_name" property="toDeptName"/>
        <result column="from_post_id" property="fromPostId"/>
        <result column="from_post_name" property="fromPostName"/>
        <result column="to_post_id" property="toPostId"/>
        <result column="to_post_name" property="toPostName"/>
        <result column="reason" property="reason"/>
        <result column="effective_date" property="effectiveDate"/>
        <result column="status" property="status"/>
        <result column="approver_id" property="approverId"/>
        <result column="approver_name" property="approverName"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectTransferPage" resultMap="TransferVOMap">
        SELECT t.*,
               emp.name AS employee_name,
               emp.emp_code,
               fd.dept_name AS from_dept_name,
               td.dept_name AS to_dept_name,
               fp.post_name AS from_post_name,
               tp.post_name AS to_post_name,
               u.nickname AS approver_name
        FROM org_transfer t
        LEFT JOIN org_employee emp ON t.employee_id = emp.id AND emp.deleted = 0
        LEFT JOIN sys_dept fd ON t.from_dept_id = fd.id AND fd.deleted = 0
        LEFT JOIN sys_dept td ON t.to_dept_id = td.id AND td.deleted = 0
        LEFT JOIN org_post fp ON t.from_post_id = fp.id AND fp.deleted = 0
        LEFT JOIN org_post tp ON t.to_post_id = tp.id AND tp.deleted = 0
        LEFT JOIN sys_user u ON t.approver_id = u.id AND u.deleted = 0
        WHERE t.deleted = 0
        <if test="employeeId != null">
            AND t.employee_id = #{employeeId}
        </if>
        <if test="transferType != null">
            AND t.transfer_type = #{transferType}
        </if>
        <if test="status != null">
            AND t.status = #{status}
        </if>
        ORDER BY t.create_time DESC
    </select>

</mapper>
